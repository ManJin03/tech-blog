{
  "name": "personal-blog",
  "version": "1.1.0",
  "description": "个人技术博客 - 文章存储于 Cloudflare KV，由 Pages Functions 动态渲染",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "serve": "node build.js && npx --yes serve dist -p 8881",
    "new": "node scripts/new-post.js",
    "seed": "node scripts/seed-kv.js",
    "kv:seed": "npx wrangler kv bulk put --binding=KV kv-seed.json",
    "kv:seed-remote": "npx wrangler kv bulk put --binding=KV --remote kv-seed.json",
    "pages:dev": "npx wrangler pages dev dist"
  },
  "keywords": [
    "blog",
    "cloudflare-pages",
    "cloudflare-kv",
    "markdown",
    "technical"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "marked-highlight": "^2.1.1"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "wrangler": "^4.0.0"
  }
}